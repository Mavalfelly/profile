# Email Configuration for Daily Reports
# Use Gmail App Password (not your regular password)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Email to receive analytics reports (defaults to EMAIL_USER if not set)
NOTIFICATION_EMAIL=your-notification-email@gmail.com

# Optional: Twilio for SMS notifications
# TWILIO_ACCOUNT_SID=your-twilio-sid
# TWILIO_AUTH_TOKEN=your-twilio-token
# TWILIO_PHONE_FROM=+1234567890
# TWILIO_PHONE_TO=+1234567890

# Server Port
PORT=3001
